<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/display_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/car_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:background="#99000000"
        android:paddingLeft="12dp"
        android:paddingTop="7dp"
        android:paddingRight="12dp"
        android:paddingBottom="7dp"
        android:text="VF6 Dual đang kết nối…"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="#BB111318"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/car_back"
            android:layout_width="72dp"
            android:layout_height="48dp"
            android:text="←" />

        <Button
            android:id="@+id/car_home"
            android:layout_width="78dp"
            android:layout_height="48dp"
            android:text="Home" />

        <Button
            android:id="@+id/car_swap"
            android:layout_width="78dp"
            android:layout_height="48dp"
            android:text="Swap" />

        <Button
            android:id="@+id/car_stop"
            android:layout_width="78dp"
            android:layout_height="48dp"
            android:text="Stop" />
    </LinearLayout>

</FrameLayout>
